[Unit]
Description=FerrumGate Reverse Proxy and Network Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/fgate serve --config /etc/ferrumgate
Restart=on-failure
RestartSec=3
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_NET_ADMIN
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
