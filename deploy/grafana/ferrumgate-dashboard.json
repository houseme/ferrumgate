{
  "annotations": {
    "list": []
  },
  "description": "FerrumGate operational metrics dashboard (Prometheus /api/metrics, ferrumgate_* prefix per D12)",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ferrumgate_uptime_seconds",
          "legendFormat": "uptime",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Process RSS Memory",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "ferrumgate_proc_rss_bytes",
          "legendFormat": "rss",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Open File Descriptors",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "ferrumgate_proc_open_fds",
          "legendFormat": "fds",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Firing Performance Alerts",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "ferrumgate_perf_alerts_firing",
          "legendFormat": "firing",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Web Service Responses by Status Class",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (class) (rate(ferrumgate_site_responses_total[5m]))",
          "legendFormat": "{{class}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "WAF Requests & Denials",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "rate(ferrumgate_waf_requests_total[5m])",
          "legendFormat": "evaluated",
          "refId": "A"
        },
        {
          "expr": "rate(ferrumgate_waf_denied_total[5m])",
          "legendFormat": "denied",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Port Forward Active Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "ferrumgate_portforward_active_connections",
          "legendFormat": "{{protocol}} {{listen}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Protocol Route Hits & STUN Connections",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (route) (rate(ferrumgate_protoroute_route_hits_total[5m]))",
          "legendFormat": "route {{route}}",
          "refId": "A"
        },
        {
          "expr": "sum by (rule) (rate(ferrumgate_stun_connections_total[5m]))",
          "legendFormat": "stun {{rule}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 9,
      "type": "table",
      "title": "TLS Certificate Days Remaining",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "ferrumgate_cert_days_remaining",
          "legendFormat": "{{cert}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Build Info & Threads",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "ferrumgate_build_info",
          "legendFormat": "{{version}}",
          "refId": "A"
        },
        {
          "expr": "ferrumgate_proc_threads",
          "legendFormat": "threads",
          "refId": "B"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["ferrumgate", "gateway", "proxy"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "title": "FerrumGate Overview",
  "uid": "ferrumgate-overview",
  "version": 1
}
